---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/layout/Button.astro";
import PageHero from "../components/sections/PageHero.astro";
import Packages from "../components/sections/Packages.astro";
import Compare from "../components/sections/Compare.astro";
import Process from "../components/sections/Process.astro";
import Faq from "../components/sections/Faq.astro";
import ClosingCta from "../components/sections/ClosingCta.astro";
import { waLink } from "../config";
import { addons, care, fixedPackages, SHOW_PRICES, rupiah } from "../data/packages";

const consult = waLink("Halo Revize, saya mau konsultasi gratis soal paket website untuk usaha saya.");

const choose = [
  { when: "Baru mulai, ingin cepat online, dan dana terbatas", pick: "Revize Start" },
  { when: "Usaha jasa yang ingin terlihat profesional dan dipercaya", pick: "Revize Profil" },
  { when: "Punya banyak produk dan pesanan lewat WhatsApp", pick: "Revize Katalog" },
  { when: "Butuh booking, pembayaran online, atau fitur khusus", pick: "Revize Custom" },
];

const included = [
  { title: "Alamat website sendiri", body: "Domain, misalnya namausaha.com.", icon: "M12 3a9 9 0 1 0 0 18a9 9 0 1 0 0-18zM3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9M12 3c-2.5 2.6-3.8 5.6-3.8 9s1.3 6.4 3.8 9" },
  { title: "Tempat website disimpan", body: "Hosting, supaya website bisa dibuka 24 jam.", icon: "M4 4h16v6H4zM4 14h16v6H4zM8 7h.01M8 17h.01" },
  { title: "Gembok keamanan", body: "SSL, supaya tidak muncul peringatan \"tidak aman\".", icon: "M6 11h12v9H6zM8.5 11V8a3.5 3.5 0 0 1 7 0v3" },
  { title: "Tampil rapi di HP", body: "Nyaman dibuka di HP maupun laptop.", icon: "M8 3h8a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM11 18h2" },
  { title: "Tombol WhatsApp", body: "Pelanggan bisa langsung chat Anda.", icon: "M4 20l1.5-4A8 8 0 1 1 8 18.5z" },
  { title: "Terdaftar di Google", body: "Pengaturan dasar supaya lebih mudah ditemukan.", icon: "M11 4a7 7 0 1 0 0 14a7 7 0 1 0 0-14zM20 20l-4-4" },
  { title: "Website milik Anda", body: "Alamat atas nama Anda, file diserahkan setelah lunas.", icon: "M8 15a4 4 0 1 0 0-8a4 4 0 1 0 0 8zM12 11h9M18 11v3M21 11v2" },
  { title: "Konsultasi gratis", body: "Ngobrol dulu sebelum memutuskan.", icon: "M4 5h16v11H9l-5 4z" },
];

const durations = fixedPackages.map((p) => `${p.short} ${p.duration}`).join(", ");

const faqs = [
  {
    q: "Apakah sudah termasuk domain dan hosting?",
    a: "Ya, untuk tahun pertama. Alamat website (domain), tempat penyimpanan (hosting), dan gembok keamanan (SSL) sudah termasuk.",
  },
  {
    q: "Berapa biaya setelah tahun pertama?",
    a: SHOW_PRICES
      ? `${fixedPackages.map((p) => `${p.short} ${rupiah(p.renewal!)}`).join(", ")} per tahun. Kalau Anda ambil paket perawatan, biaya ini sudah termasuk.`
      : "Ada biaya perpanjangan tiap tahun untuk alamat dan tempat website, seperti sewa toko. Besarnya kami tulis di penawaran sejak awal. Kalau Anda ambil paket perawatan, biaya ini sudah termasuk.",
  },
  {
    q: "Bagaimana sistem pembayarannya?",
    a: "Dua kali bayar. Separuh (DP 50%) sebelum kami mulai, sisanya setelah website selesai dan Anda setujui.",
  },
  {
    q: "Saya belum punya logo, foto, atau teks. Bisa?",
    a: "Bisa. Kami bisa bantu buatkan logo, identitas brand, dan semua teks website sebagai layanan tambahan.",
  },
  {
    q: "Apakah saya bisa mengubah isi website sendiri?",
    a: "Di paket Katalog, bisa. Anda ganti produk, harga, dan foto sendiri lewat HP. Untuk Start dan Profil, fitur ini bisa ditambahkan, atau perubahan kami kerjakan lewat paket perawatan.",
  },
  {
    q: "Apakah website saya pasti muncul di halaman pertama Google?",
    a: "Tidak ada yang bisa menjamin posisi tertentu di Google. Yang kami kerjakan: website cepat, rapi di HP, diatur supaya mudah dipahami Google, dan sudah didaftarkan ke Google.",
  },
  {
    q: "Siapa pemilik alamat dan website-nya?",
    a: "Anda. Alamat website didaftarkan atas nama Anda, dan file website kami serahkan setelah lunas.",
  },
  {
    q: "Berapa lama sampai website online?",
    a: `${durations}. Waktunya dihitung sejak materi lengkap: logo, foto, dan info usaha.`,
  },
];
---

<BaseLayout
  title="Paket Jasa Pembuatan Website UMKM — Revize"
  description="Empat paket website untuk UMKM: landing page, company profile, katalog online, dan custom. Sudah termasuk alamat website tahun pertama. Konsultasi gratis."
  headerTone="dark"
>
  <PageHero
    label="Paket jasa pembuatan website"
    lead="Pilih dari empat paket: Start, Profil, Katalog, atau Custom. Biayanya jelas sejak awal, dan alamat website tahun pertama sudah termasuk."
  >
    Website yang bikin usaha Anda <span class="text-lime">dipercaya</span>.
    <Fragment slot="actions">
      <Button href={consult} target="_blank" rel="noopener" class="min-h-14 w-full px-8 text-lg sm:w-auto">Konsultasi gratis</Button>
      <Button variant="outline" href="#paket" class="min-h-14 w-full px-8 text-lg sm:w-auto">Lihat paket</Button>
    </Fragment>
  </PageHero>

  <Packages />

  <section class="mx-auto max-w-7xl px-4 py-16 md:px-8 md:py-24">
    <p class="font-semibold text-violet">Bingung memilih?</p>
    <h2 class="mt-3 max-w-3xl text-3xl font-bold md:text-5xl">Paket mana yang cocok untuk Anda?</h2>
    <ul data-reveal class="mt-10">
      {choose.map((c) => (
        <li class="flex flex-col gap-3 border-t-2 border-ink py-6 md:flex-row md:items-center md:justify-between">
          <p class="text-lg">{c.when}</p>
          <p class="self-start rounded-full bg-violet px-5 py-2 font-display font-bold text-cream md:self-auto">{c.pick}</p>
        </li>
      ))}
    </ul>
    <div class="flex flex-col gap-4 border-t-2 border-ink pt-8 md:flex-row md:items-center md:justify-between">
      <p class="max-w-2xl text-lg">Masih ragu? Konsultasi gratis dulu. Kalau paket yang lebih hemat sudah cukup, kami akan bilang.</p>
      <Button href={consult} target="_blank" rel="noopener" class="min-h-12 self-start md:self-auto">Konsultasi gratis</Button>
    </div>
  </section>

  <Compare />

  <section class="bg-ink text-cream">
    <div class="mx-auto max-w-7xl px-4 py-20 md:px-8 md:py-32">
      <p class="font-semibold text-lime">Di semua paket</p>
      <h2 class="mt-3 max-w-3xl text-3xl font-bold md:text-5xl">Yang selalu Anda dapat</h2>
      <ul data-reveal class="mt-12 grid grid-cols-2 gap-x-5 gap-y-10 md:grid-cols-4">
        {included.map((i) => (
          <li>
            <span class="inline-flex size-12 items-center justify-center rounded-full bg-lime text-ink" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={i.icon} /></svg>
            </span>
            <h3 class="mt-4 text-lg font-bold">{i.title}</h3>
            <p class="mt-1 text-cream/80">{i.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-20 md:px-8 md:py-32">
    <p class="font-semibold text-violet">Layanan tambahan</p>
    <h2 class="mt-3 max-w-3xl text-3xl font-bold md:text-5xl">Tambah sesuai kebutuhan</h2>
    <p class="mt-4 max-w-2xl text-lg text-ink/80">
      Paket utama tetap hemat. Yang belum Anda butuhkan sekarang, bisa ditambah kapan saja.
      {!SHOW_PRICES && " Harga layanan tambahan kami sebutkan saat konsultasi."}
    </p>
    <ul data-reveal class="mt-10 grid gap-x-10 md:grid-cols-2">
      {addons.map((a) => (
        <li class="flex flex-col gap-1 border-t border-ink/15 py-5 sm:flex-row sm:justify-between sm:gap-6">
          <div>
            <h3 class="font-sans text-lg font-bold tracking-normal">{a.name}</h3>
            <p class="mt-1 text-ink/80">{a.note}</p>
          </div>
          {SHOW_PRICES && (
            <p class="shrink-0 font-semibold text-violet sm:text-right">
              {typeof a.price === "number" ? `${a.from ? "mulai " : ""}${rupiah(a.price)} ${a.unit ?? ""}` : a.price}
            </p>
          )}
        </li>
      ))}
    </ul>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-20 md:px-8 md:pb-32">
    <p class="font-semibold text-violet">Perawatan bulanan</p>
    <h2 class="mt-3 max-w-3xl text-3xl font-bold md:text-5xl">Kami jaga website Anda tetap jalan dan aman</h2>
    <p class="mt-4 max-w-2xl text-lg text-ink/80">
      Setelah online, website perlu dirawat, seperti servis rutin kendaraan. Kalau pilih perawatan, biaya perpanjangan tahunan sudah termasuk.
    </p>
    <ul data-reveal class="mt-10 grid gap-5 md:grid-cols-2">
      {care.map((c) => (
        <li class="flex flex-col rounded-[2rem] border border-ink/10 p-6 md:p-8">
          <h3 class="text-2xl font-bold">{c.name}</h3>
          <ul class="mt-6 space-y-3">
            {c.features.map((f) => (
              <li class="flex gap-3">
                <span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-lime text-ink" aria-hidden="true">
                  <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                </span>
                {f}
              </li>
            ))}
          </ul>
          <div class="mt-auto pt-8">
            {SHOW_PRICES ? (
              <p class="font-display text-2xl font-bold">{rupiah(c.price)} <span class="font-sans text-base font-semibold">/ bulan</span></p>
            ) : (
              <Button variant="outline" href={waLink(`Halo Revize, saya mau tanya harga paket perawatan ${c.name}.`)} target="_blank" rel="noopener">
                Tanya harga<span class="sr-only">: {c.name}</span>
              </Button>
            )}
          </div>
        </li>
      ))}
    </ul>
  </section>

  <Process>
    <p class="mt-12 max-w-2xl rounded-[2rem] border-2 border-cream/30 p-6 text-lg">
      <span class="font-bold">Pembayaran dua kali:</span> separuh (DP 50%) sebelum kami mulai, sisanya setelah website selesai dan Anda setujui.
    </p>
  </Process>

  <section class="mx-auto max-w-7xl px-4 py-20 md:px-8 md:py-32">
    <p class="font-semibold text-violet">Ditulis terbuka</p>
    <h2 class="mt-3 max-w-3xl text-3xl font-bold md:text-5xl">Biaya setelah tahun pertama</h2>
    <p class="mt-4 max-w-2xl text-lg text-ink/80">
      Tiap tahun ada biaya perpanjangan alamat dan tempat website, seperti sewa toko. Isinya: alamat website, tempat penyimpanan, gembok keamanan, dan pengecekan rutin.
    </p>
    {SHOW_PRICES ? (
      <table class="mt-8 w-full max-w-xl border-collapse text-left">
        <caption class="sr-only">Biaya perpanjangan per tahun</caption>
        <thead>
          <tr class="border-b-2 border-ink">
            <th scope="col" class="py-3 font-semibold">Paket</th>
            <th scope="col" class="py-3 font-semibold">Per tahun</th>
          </tr>
        </thead>
        <tbody>
          {fixedPackages.map((p) => (
            <tr class="border-b border-ink/15">
              <th scope="row" class="py-3 font-semibold">{p.name}</th>
              <td class="py-3">{rupiah(p.renewal!)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    ) : (
      <p class="mt-4 max-w-2xl text-lg text-ink/80">Besarnya kami tulis di penawaran, sebelum Anda membayar apa pun.</p>
    )}
    <p class="mt-4 max-w-2xl text-lg text-ink/80">Kalau Anda ambil paket perawatan, biaya ini sudah termasuk.</p>
  </section>

  <Faq items={faqs} />
  <ClosingCta />
</BaseLayout>
