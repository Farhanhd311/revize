---
// Port of React Bits CircularText (fill layout) without `motion`: letters are placed
// server-side, GSAP spins the ring and eases timeScale on hover.
interface Props {
  text: string;
  size?: number;
  class?: string;
}

const { text, size = 120, class: className } = Astro.props;
const letters = Array.from(text);
---

<div
  data-circular
  role="img"
  aria-label={text}
  class:list={["relative shrink-0 rounded-full font-display text-[11px] font-bold", className]}
  style={`width:${size}px;height:${size}px`}
>
  <div data-ring class="absolute inset-0" aria-hidden="true">
    {letters.map((letter, i) => (
      <span class="absolute inset-0 text-center whitespace-pre" style={`transform:rotate(${(360 / letters.length) * i}deg)`}>
        {letter}
      </span>
    ))}
  </div>
  <div class="absolute inset-0 flex items-center justify-center" aria-hidden="true"><slot /></div>
</div>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    for (const el of document.querySelectorAll<HTMLElement>("[data-circular]")) {
      const spin = gsap.to(el.querySelector("[data-ring]"), { rotation: 360, duration: 20, ease: "none", repeat: -1 });
      const speed = (timeScale: number) => () => gsap.to(spin, { timeScale, duration: 0.6, ease: "power2.out" });
      el.addEventListener("pointerenter", speed(4));
      el.addEventListener("pointerleave", speed(1));
      // stop spinning while off-screen
      ScrollTrigger.create({ trigger: el, onToggle: (self) => spin.paused(!self.isActive) });
    }
  }
</script>
