---
import ScrollReveal from "../react/ScrollReveal";

// TODO: ganti "Hubungi untuk harga" dengan "Mulai dari Rp..." setelah harga paket final.
// TODO: "Branding & Logo" tergantung pertanyaan terbuka PRD no. 3 (branding masuk MVP atau tidak).
const services = [
  {
    title: "Website Company Profile",
    body: "Profil usaha yang rapi dan meyakinkan, lengkap dengan layanan, lokasi, dan tombol WhatsApp.",
    icon: "M5 4h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zM3 9h18",
  },
  {
    title: "Landing Page",
    body: "Satu halaman fokus untuk promo atau produk unggulan, dirancang supaya pengunjung langsung menghubungi Anda.",
    icon: "M12 3v3M12 18v3M3 12h3M18 12h3M12 7a5 5 0 1 0 0 10a5 5 0 1 0 0-10z",
  },
  {
    title: "Katalog Online",
    body: "Produk dan harga tersusun rapi dalam katalog yang mudah dibagikan ke pelanggan lewat WhatsApp atau Instagram.",
    icon: "M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z",
  },
  {
    title: "Branding & Logo",
    body: "Logo, warna, dan gaya visual yang konsisten supaya usaha Anda mudah dikenali dan diingat.",
    icon: "M12 3l2.6 5.6 6.1.7-4.5 4.2 1.2 6L12 16.5 6.6 19.5l1.2-6-4.5-4.2 6.1-.7z",
  },
];
---

<section class="mx-auto max-w-7xl px-4 py-20 md:px-8 md:py-32">
  <p class="font-semibold text-violet">Layanan</p>
  <ScrollReveal client:visible mode="enter" enableBlur={false} containerClassName="mt-3 max-w-3xl">
    Semua yang usaha Anda butuhkan untuk tampil online
  </ScrollReveal>

  <ul data-services-grid class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
    {services.map((s) => (
      <li data-service-card class="flex flex-col rounded-[2rem] border border-ink/10 p-6 md:p-8">
        <span class="inline-flex size-14 items-center justify-center rounded-full bg-lime text-ink">
          <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true">
            <path d={s.icon} />
          </svg>
        </span>
        <h3 class="mt-6 text-xl font-bold">{s.title}</h3>
        <p class="mt-3 text-ink/80">{s.body}</p>
        <p class="mt-auto pt-6 font-semibold text-violet">Hubungi untuk harga</p>
      </li>
    ))}
  </ul>

  <a href="/layanan" class="mt-10 inline-flex min-h-11 items-center font-semibold text-violet underline underline-offset-8 hover:text-plum">
    Lihat detail layanan
  </a>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    gsap.from("[data-service-card]", {
      y: 40,
      opacity: 0,
      duration: 0.8,
      ease: "power3.out",
      stagger: 0.12,
      scrollTrigger: { trigger: "[data-services-grid]", start: "top 80%", once: true },
    });
  }
</script>
