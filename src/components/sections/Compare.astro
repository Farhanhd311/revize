---
import { comparison, fixedPackages, SHOW_PRICES, rupiah } from "../../data/packages";

const rows = SHOW_PRICES ? [...comparison, { label: "Harga", values: fixedPackages.map((p) => rupiah(p.price)) }] : comparison;
---

<section id="bandingkan" class="mx-auto max-w-7xl scroll-mt-24 px-4 py-16 md:px-8 md:py-24">
  <p class="font-semibold text-violet">Perbandingan</p>
  <h2 id="compare-title" class="mt-3 max-w-3xl text-3xl font-bold md:text-5xl">Bandingkan isi setiap paket</h2>
  <p class="mt-4 text-ink/80 md:hidden">Geser tabel ke samping untuk melihat semua paket.</p>

  <!-- One real table for every width: horizontal scroll on phones, first column stays put. Focusable so keyboards can scroll it.
       `relative` makes the scroller clip the absolutely positioned sr-only labels; without it they widen the page. -->
  <div
    tabindex="0"
    role="region"
    aria-labelledby="compare-title"
    data-lenis-prevent-horizontal
    class="relative mt-8 overflow-x-auto rounded-[2rem] border border-ink/10"
  >
    <table class="w-full min-w-[40rem] table-fixed border-collapse text-left">
      <caption class="sr-only">Perbandingan isi paket Start, Profil, dan Katalog</caption>
      <thead>
        <tr>
          <th scope="col" class="sticky left-0 w-40 bg-cream p-4 align-bottom text-sm font-semibold text-ink/70 md:w-72">Isi paket</th>
          {fixedPackages.map((p) => (
            <th scope="col" class="p-4 align-bottom">
              {p.recommended && (
                <span class="mb-2 inline-flex rounded-full bg-lime px-3 py-1 text-xs font-semibold text-ink">Rekomendasi kami</span>
              )}
              <span class="block font-display text-lg font-bold">{p.short}</span>
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr class="border-t border-ink/10">
            <th scope="row" class="sticky left-0 bg-cream p-4 font-semibold">{r.label}</th>
            {r.values.map((v) => (
              <td class="p-4">
                {v === true ? (
                  <span class="inline-flex size-7 items-center justify-center rounded-full bg-lime text-ink">
                    <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                    <span class="sr-only">Ya</span>
                  </span>
                ) : v === false ? (
                  <><span aria-hidden="true" class="text-ink/40">—</span><span class="sr-only">Tidak termasuk</span></>
                ) : (
                  v
                )}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="mt-6 max-w-3xl text-ink/80">
    Satu revisi = satu kumpulan masukan yang dikirim sekaligus. Waktu pengerjaan dihitung sejak materi (logo, foto, info usaha) lengkap.
  </p>
</section>
