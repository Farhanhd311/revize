---
interface Props {
  items?: { q: string; a: string }[]; // defaults to the home page FAQ; `a` is trusted HTML (our own copy only)
}

import { fixedPackages, SHOW_PRICES, INTRO_PRICING, rupiah } from "../../data/packages";

const start = fixedPackages[0];
const priceAnswer = INTRO_PRICING
  ? `Mulai ${rupiah(start.introPrice!)} untuk paket ${start.short}, dengan harga perkenalan bagi 5 klien pertama.`
  : `Mulai ${rupiah(start.price!)} untuk paket ${start.short}.`;

// TODO: jawaban mengikuti FAQ di LAYANAN.md. Harga sudah final; cek ulang durasi saat final.
const homeFaqs = [
  {
    q: "Berapa biaya pembuatan website?",
    a: SHOW_PRICES
      ? `${priceAnswer} Rincian semua paket ada di <a href="/layanan" class="font-semibold text-violet underline underline-offset-4">halaman Paket</a>.`
      : "Tergantung paket yang Anda pilih: Start, Profil, Katalog, atau Custom. Setelah konsultasi gratis, kami kirim penawaran tertulis dengan harga yang jelas.",
  },
  {
    // TODO: cek durasi saat LAYANAN.md final.
    q: "Berapa lama sampai website online?",
    a: "Start sekitar 3–5 hari kerja, Profil 7–14 hari kerja, dan Katalog 14–21 hari kerja. Waktunya dihitung sejak materi lengkap: logo, foto, dan info usaha.",
  },
  {
    q: "Apakah sudah termasuk domain dan hosting?",
    a: "Ya, untuk tahun pertama. Alamat website (domain), tempat penyimpanan (hosting), dan tanda gembok keamanan (SSL) sudah termasuk. Biaya tahun berikutnya kami jelaskan sejak awal.",
  },
  {
    q: "Apakah saya bisa mengubah isi website sendiri?",
    a: "Bisa, di paket Katalog. Anda bisa ganti produk, harga, dan foto sendiri lewat HP. Untuk paket lain, perubahan setelah website online bisa kami kerjakan lewat paket perawatan bulanan.",
  },
  {
    q: "Bagaimana sistem pembayarannya?",
    a: "Dua kali bayar. Separuh (DP 50%) sebelum kami mulai, sisanya setelah website selesai dan Anda setujui.",
  },
  {
    q: "Saya belum punya logo, foto, atau teks. Bisa?",
    a: "Bisa. Kami bantu menyusun kata-kata untuk website Anda. Kalau belum punya logo, kami juga bisa buatkan sebagai layanan tambahan.",
  },
];

const { items: faqs = homeFaqs } = Astro.props;
---

<section data-wa-hide class="mx-auto max-w-3xl px-4 py-20 md:py-32">
  <p class="font-semibold text-violet">FAQ</p>
  <h2 class="mt-3 text-3xl font-bold md:text-5xl">Pertanyaan yang sering ditanyakan</h2>

  <div class="mt-12 divide-y divide-ink/15 border-y border-ink/15">
    {faqs.map((f) => (
      <details class="group">
        <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-6 py-5 text-lg font-bold [&::-webkit-details-marker]:hidden">
          {f.q}
          <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-violet text-cream group-open:rotate-45 motion-safe:transition-transform" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <path d="M12 5v14M5 12h14" />
            </svg>
          </span>
        </summary>
        <p class="pb-6 text-ink/80" set:html={f.a} />
      </details>
    ))}
  </div>
</section>

<style>
  /* Exception to the transform/opacity rule (CLAUDE.md §4): click-only height animation.
     Browsers without ::details-content or interpolate-size just open/close natively. */
  details {
    interpolate-size: allow-keywords;
  }
  details::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size 0.4s ease,
      content-visibility 0.4s allow-discrete;
  }
  details[open]::details-content {
    block-size: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    details::details-content {
      transition: none;
    }
  }
</style>
