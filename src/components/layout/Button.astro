---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  variant?: "lime" | "outline" | "ink";
}

const { variant = "lime", class: className, ...attrs } = Astro.props;

const variants = {
  lime: "bg-lime text-ink hover:bg-ink hover:text-lime",
  outline: "border-2 border-current hover:bg-plum hover:border-plum hover:text-cream",
  ink: "bg-ink text-cream hover:bg-plum", // for lime backgrounds
};
---

<a
  class:list={[
    "inline-flex min-h-11 items-center justify-center rounded-full px-6 font-semibold whitespace-nowrap motion-safe:transition-colors",
    variants[variant],
    className,
  ]}
  {...attrs}
>
  <slot />
</a>
