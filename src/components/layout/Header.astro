---
import Button from "./Button.astro";
import { nav, site, waLink } from "../../config";

interface Props {
  tone?: "light" | "dark"; // dark = sits on a violet hero, so text starts cream
}

const { tone = "light" } = Astro.props;
const path = Astro.url.pathname;
const cta = waLink("Halo Revize, saya mau konsultasi gratis soal website untuk usaha saya.");
---

<header
  id="site-header"
  class:list={[
    "fixed inset-x-0 top-0 z-50 data-scrolled:bg-cream/80 data-scrolled:backdrop-blur-md data-scrolled:text-ink data-scrolled:shadow-sm motion-safe:transition-colors",
    tone === "dark" ? "text-cream" : "text-ink",
  ]}
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 md:h-20 md:px-8">
    <!-- TODO: ganti wordmark teks dengan logo SVG Revize -->
    <a href="/" class="font-display text-xl font-bold tracking-tight md:text-2xl">{site.name}</a>

    <nav aria-label="Menu utama" class="hidden md:block">
      <ul class="flex items-center gap-8">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={path.startsWith(item.href) ? "page" : undefined}
              class="inline-flex min-h-11 items-center font-semibold underline-offset-8 hover:underline aria-[current=page]:underline"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <Button href={cta} target="_blank" rel="noopener" class="max-sm:hidden">Konsultasi gratis</Button>
      <button
        type="button"
        id="menu-open"
        aria-label="Buka menu"
        aria-haspopup="dialog"
        aria-controls="menu"
        class="inline-flex size-11 items-center justify-center rounded-full md:hidden"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>
</header>

<dialog
  id="menu"
  aria-label="Menu"
  data-lenis-prevent
  class="m-0 h-dvh max-h-none w-full max-w-none bg-violet p-0 text-cream"
>
  <div class="flex h-full flex-col px-4 pb-8">
    <div class="flex h-16 items-center justify-between">
      <a href="/" class="font-display text-xl font-bold tracking-tight">{site.name}</a>
      <form method="dialog">
        <button aria-label="Tutup menu" class="inline-flex size-11 items-center justify-center rounded-full">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>
      </form>
    </div>

    <nav aria-label="Menu utama" class="mt-10">
      <ul class="space-y-2">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={path.startsWith(item.href) ? "page" : undefined}
              class="inline-flex min-h-11 items-center font-display text-4xl font-bold tracking-tight aria-[current=page]:text-lime"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <Button href={cta} target="_blank" rel="noopener" class="mt-auto w-full text-lg">Konsultasi gratis</Button>
  </div>
</dialog>

<script>
  const header = document.getElementById("site-header")!;
  const menu = document.getElementById("menu") as HTMLDialogElement;

  const onScroll = () => header.toggleAttribute("data-scrolled", scrollY > 8);
  onScroll();
  addEventListener("scroll", onScroll, { passive: true });

  // showModal() gives Esc-to-close, focus trap and focus return for free
  document.getElementById("menu-open")!.addEventListener("click", () => menu.showModal());
  // don't come back to an open menu via the back button (bfcache)
  addEventListener("pageshow", () => menu.close());
</script>
