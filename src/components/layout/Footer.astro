---
import { nav, site, waLink } from "../../config";

const link = "inline-flex min-h-11 items-center hover:text-lime motion-safe:transition-colors";
---

<footer class="bg-ink text-cream">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-16 md:grid-cols-3 md:px-8">
    <div>
      <!-- TODO: ganti wordmark teks dengan logo SVG Revize -->
      <a href="/" class="font-display text-2xl font-bold tracking-tight">{site.name}</a>
      <p class="mt-4 max-w-xs text-cream/80">Website dan identitas brand untuk UMKM yang ingin tampil berani dan mudah ditemukan.</p>
    </div>

    <nav aria-label="Menu footer">
      <h2 class="font-display text-sm font-bold tracking-normal text-lime uppercase">Menu</h2>
      <ul class="mt-3">
        {nav.map((item) => <li><a href={item.href} class={link}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div>
      <h2 class="font-display text-sm font-bold tracking-normal text-lime uppercase">Kontak</h2>
      <ul class="mt-3">
        <li><a href={waLink("Halo Revize, saya mau tanya-tanya soal jasa website.")} target="_blank" rel="noopener" class={link}>WhatsApp</a></li>
        <li><a href={`mailto:${site.email}`} class={link}>{site.email}</a></li>
        <li><a href={`https://instagram.com/${site.instagram}`} target="_blank" rel="noopener" class={link}>Instagram @{site.instagram}</a></li>
      </ul>
      <p class="mt-3 text-cream/80">Area layanan: {site.area}</p>
    </div>
  </div>

  <div class="border-t border-cream/15">
    <p class="mx-auto max-w-7xl px-4 py-6 text-sm text-cream/70 md:px-8">© {new Date().getFullYear()} {site.name}. Hak cipta dilindungi.</p>
  </div>

  <!-- textLength stretches the word to exactly the container width, so it can never cause horizontal scroll -->
  <div class="mx-auto max-w-7xl overflow-hidden px-4 md:px-8">
    <svg data-wordmark aria-hidden="true" viewBox="0 0 1000 168" class="block w-full fill-cream/10">
      <!-- font-size 220 ≈ 1000 units wide in Unbounded Bold (cap height ≈ 166), so textLength barely distorts it -->
      <text x="0" y="167" font-size="220" textLength="1000" lengthAdjust="spacingAndGlyphs" class="font-display font-bold">REVIZE</text>
    </svg>
  </div>
</footer>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    gsap.from("[data-wordmark]", {
      yPercent: 40,
      opacity: 0,
      duration: 1.2,
      ease: "expo.out",
      scrollTrigger: { trigger: "footer", start: "top 80%", once: true },
    });
  }
</script>
