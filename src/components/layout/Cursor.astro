<!-- Decorative follower; the native cursor stays visible. Ink border + cream halo keeps it visible on every background. -->
<div data-cursor aria-hidden="true" class="group pointer-events-none fixed top-0 left-0 z-[100] hidden">
  <div
    class="size-4 rounded-full border-2 border-ink shadow-[0_0_0_2px_var(--color-cream)] transition-[scale,background-color] duration-300 ease-out group-data-hover:scale-250 group-data-hover:bg-lime/50"
  >
  </div>
</div>

<script>
  import { gsap } from "gsap";

  const el = document.querySelector<HTMLElement>("[data-cursor]")!;

  if (matchMedia("(pointer: fine) and (prefers-reduced-motion: no-preference)").matches) {
    el.classList.remove("hidden");
    gsap.set(el, { xPercent: -50, yPercent: -50, opacity: 0 });
    const x = gsap.quickTo(el, "x", { duration: 0.35, ease: "power3.out" });
    const y = gsap.quickTo(el, "y", { duration: 0.35, ease: "power3.out" });
    let shown = false;

    addEventListener("pointermove", (e) => {
      if (!shown) {
        gsap.set(el, { x: e.clientX, y: e.clientY });
        gsap.to(el, { opacity: 1, duration: 0.3 });
        shown = true;
      }
      x(e.clientX);
      y(e.clientY);
    });
    document.documentElement.addEventListener("mouseleave", () => {
      gsap.to(el, { opacity: 0, duration: 0.3 });
      shown = false;
    });
    document.addEventListener("pointerover", (e) => {
      el.toggleAttribute("data-hover", !!(e.target as Element).closest?.("a, button, summary, label"));
    });
  }
</script>
