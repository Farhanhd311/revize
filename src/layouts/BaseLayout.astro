---
import "@fontsource-variable/unbounded";
import "@fontsource-variable/manrope";
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import ScrollProgress from "../components/layout/ScrollProgress.astro";
import Cursor from "../components/layout/Cursor.astro";
import WhatsAppFloat from "../components/layout/WhatsAppFloat.astro";

interface Props {
  title: string;
  description: string;
  headerTone?: "light" | "dark";
}

const { title, description, headerTone = "light" } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a
      href="#main"
      class="fixed top-2 left-2 z-[60] -translate-y-20 rounded-full bg-lime px-5 py-3 font-semibold text-ink focus:translate-y-0"
    >
      Langsung ke konten
    </a>
    <ScrollProgress />
    <Cursor />
    <Header tone={headerTone} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />
    <script>
      import "../lib/motion";
    </script>
  </body>
</html>
